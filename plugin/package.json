{
  "name": "dsh-creation-mode",
  "version": "3.0.2",
  "type": "module",
  "description": "创作模式 / Creation Mode：333 种代码动画风格，在 DeepSeek Harness 对话里直接出片。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "code-animation",
    "video",
    "animation"
  ],
  "homepage": "https://github.com/wyf-yfw/dsh-creation-mode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyf-yfw/dsh-creation-mode.git",
    "directory": "plugin"
  },
  "engines": {
    "dsh": ">=0.2.1-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "data.js",
    "tools.js",
    "flow.js",
    "client.js",
    "cordis.patch.yml",
    "styles.json",
    "stills",
    "references",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
